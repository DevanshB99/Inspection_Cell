      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        object_frame:
          turntable_disc_link:
            turntable_base_link_inertia:
              turntable_base_link:
                planning_volume:
                  {}
                turntable_base:
                  {}
                ur5e_mount_link:
                  table_link:
                    {}
                  ur_base_link:
                    base:
